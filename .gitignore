// ============================================
// .gitignore - ARQUIVOS A IGNORAR
// ============================================

# Dependências e módulos
node_modules/
package-lock.json
yarn.lock

# Variáveis de ambiente
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE e Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Cache do browser
.cache/
dist/
build/

# Arquivos temporários
tmp/
temp/
*.tmp

# Dados locais (se salvar em arquivos)
data/
uploads/
*.db
*.sqlite

# Sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
